# Nginx 中间件配置示例（复制为 nginx.yml 使用；nginx.yml 已被 gitignore 忽略）。
# 缺省值来自《安徽农金Nginx、Keepalived运维巡检手册v1.0》环境信息
# （NGINX_HOME=/opt/nginx、NGINX_PORT=8010、VIP=192.168.0.253）。
# 现场路径不同时在此覆盖；nginx_bin 支持 RPM(/usr/sbin/nginx) 或源码
# (/opt/nginx/sbin/nginx) 安装路径。

# Nginx 可执行文件路径（RPM 安装 /usr/sbin/nginx；源码安装 /opt/nginx/sbin/nginx）
# nginx_bin: /usr/sbin/nginx

# Nginx 主配置文件
# nginx_conf: /opt/nginx/conf/nginx.conf

# 关键日志与访问日志路径
# nginx_error_log: /opt/nginx/logs/error.log
# nginx_access_log: /opt/nginx/logs/access.log

# Nginx 监听端口
# nginx_port: 8010

# Nginx 白名单 IP：这些主机上 Nginx 必须运行；若未运行 → CRIT「未运行」。
# 白名单外的主机未运行 Nginx → 跳过该主机的 Nginx 指标（不视为故障）。
# whitelist:
#   - 192.168.0.10
#   - 192.168.0.101
