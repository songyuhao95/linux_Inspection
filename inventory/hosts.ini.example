# 项目本地远程巡检 inventory 模板。
# 复制为 inventory/hosts.ini 后填写真实 ansible_password；hosts.ini 已被 gitignore，禁止提交真实凭据。
# Linux 上建议执行：chmod 600 inventory/hosts.ini

[inspection]
node-01 ansible_host=192.0.2.10
node-02 ansible_host=192.0.2.11

[inspection:vars]
ansible_connection=ssh
ansible_user=aqwh
ansible_password=REPLACE_WITH_REAL_PASSWORD
